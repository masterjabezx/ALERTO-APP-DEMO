# Safe configuration reference. Secret values are generated or referenced by Render.
APP_NAME="ALERTO APP — TESTING ENVIRONMENT"
APP_ENV=production
APP_KEY=__GENERATED_BY_RENDER_BLUEPRINT__
APP_DEBUG=false
APP_URL=__RENDER_EXTERNAL_URL__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_URL=
DB_HOST=__RENDER_PRIVATE_MYSQL_HOST__
DB_PORT=3306
DB_DATABASE=alerto_demo
DB_USERNAME=alerto_demo
DB_PASSWORD=__RENDER_GENERATED_MYSQL_PASSWORD__
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=null
MAIL_MAILER=log
BCRYPT_ROUNDS=12

# Keep Meta/Facebook integration disabled for this demo.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_SECRET=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_VERIFY_TOKEN=
META_PAGE_NAME="ALERTO APP Demo Page"
